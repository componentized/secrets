package componentized:secrets-components;

world empty {
    import componentized:secrets/types@0.1.1;
    export componentized:secrets/store@0.1.1;
    export componentized:secrets/types@0.1.1;
}

world from-config {
    import componentized:secrets/types@0.1.1;
    import wasi:config/store@0.2.0-rc.1;
    export componentized:secrets/types@0.1.1;
    export componentized:secrets/store@0.1.1;
}

world gate {
    import componentized:secrets/types@0.1.1;
    import componentized:secrets/latch@0.1.1;
    import wasi:logging/logging@0.1.0-draft;
    import componentized:secrets/store@0.1.1;
    export componentized:secrets/types@0.1.1;
    export componentized:secrets/store@0.1.1;
}

world latch {
    import componentized:secrets/types@0.1.1;
    import wasi:config/store@0.2.0-rc.1;
    import wasi:logging/logging@0.1.0-draft;
    export componentized:secrets/latch@0.1.1;
}

/// Aggregates the latches it imports into one, the `latch-n` components each use the first of them,
/// e.g. `latch-n2` uses `latch0` and `latch1`.
world latch-n {
    import componentized:secrets/types@0.1.1;
    export componentized:secrets/latch@0.1.1;
    import latch0: componentized:secrets/latch@0.1.1;
    import latch1: componentized:secrets/latch@0.1.1;
    import latch2: componentized:secrets/latch@0.1.1;
    import latch3: componentized:secrets/latch@0.1.1;
    import latch4: componentized:secrets/latch@0.1.1;
}

/// Calls a `componentized:secrets/store` the way a consumer does, for the tests of each component.
interface probe {
    use componentized:secrets/store@0.1.1.{error-code, secret};

    /// A call to `store.init`.
    record init-call {
        /// Whether the call resolved on its first poll, without waiting on the store.
        immediate: bool,
        /// The result of the call.
        %result: result<_, error-code>,
    }

    /// Calls `store.init`, waiting for it to resolve.
    init: async func() -> init-call;

    /// Calls `store.get`.
    get: func(key: string) -> result<secret, error-code>;
}

world test-consumer {
    import componentized:secrets/store@0.1.1;
    export probe;
}

/// The host the tests run the components with, see crates/test-harness. Provides the imports of every component,
/// and calls the latches and the probe. The host provides the latch a gate imports, as well as the
/// named latches a `latch-n` imports.
world test-host {
    import latch0: componentized:secrets/latch@0.1.1;
    import latch1: componentized:secrets/latch@0.1.1;
    import latch2: componentized:secrets/latch@0.1.1;
    import latch3: componentized:secrets/latch@0.1.1;
    import latch4: componentized:secrets/latch@0.1.1;
    import wasi:config/store@0.2.0-rc.1;
    import wasi:logging/logging@0.1.0-draft;
    export componentized:secrets/latch@0.1.1;
    export probe;
}
